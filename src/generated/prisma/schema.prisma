generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String  @id // Matches the Supabase auth.users UUID
  email     String  @unique
  name      String?
  avatarUrl String?

  // Example of a relation you might add later:
  // trips    Trip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
